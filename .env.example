# Inventory and local state
MIA_INVENTORY=~/.config/mia/fleet.yaml
# MIA_STATE_DIR=~/.local/state/mia        # journal, snapshots, oversized outputs, jobs

# true = only read tools are registered (no service_action, apt_upgrade, host_exec …)
# MIA_READONLY=false

# ssh: the system ssh is used (so ~/.ssh/config, the agent and Tailscale SSH work as usual)
# MIA_SSH_OPTIONS=-o ProxyJump=bastion
# MIA_SSH_CONNECT_TIMEOUT=10
# MIA_CONCURRENCY=8
# MIA_COMMAND_TIMEOUT_MS=120000
# MIA_TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale   # macOS app

# Remnawave panel (optional, read only here): node state / users online, SECRET_KEY for node_bootstrap.
# Same variables as mcp-remnawave.
# REMNAWAVE_BASE_URL=https://panel.example.com
# REMNAWAVE_API_TOKEN=
# REMNAWAVE_API_KEY=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Pin the owner's scripts to a commit for reproducible runs
# MIA_EDGE_SCRIPT_URL=https://raw.githubusercontent.com/akadorkin/remnanode-install-script/<sha>/vps-edge-run.sh
# MIA_TUNING_SCRIPT_URL=https://raw.githubusercontent.com/akadorkin/vps-network-tuning-script/<sha>/initial.sh

# Local checkouts of your own script repos, for repo_script / gitea_runner_register
# MIA_REPOS=ops=~/src/ops-scripts,haproxy=~/src/haproxy-configs
# MIA_GIT_AUTHOR="Your Name <you@example.com>"
# Command that starts mcp-remnawave, for panel steps of runbooks (JSON array or a command line)
# MIA_REMNAWAVE_MCP=["node","/path/to/mcp-remnawave/dist/index.js"]

# ru_probe: a vantage host inside the censored network with one interface per ISP, plus a datacenter control host
# MIA_PROBE_FROM=probe-ru
# MIA_PROBE_IFACES=wan0=ISP-A,wan1=ISP-B
# MIA_PROBE_CONTROL=nl-1

# Optional APIs (or keep them in ~/.config/mia/secrets.env via `mia secrets`)
# TAILSCALE_API_KEY=
# TAILSCALE_TAILNET=-
# CLOUDFLARE_API_TOKEN=
# GITEA_URL=https://git.example.com
# GITEA_TOKEN=
# BESZEL_URL=https://beszel.example.com
# BESZEL_EMAIL=
# BESZEL_PASSWORD=
